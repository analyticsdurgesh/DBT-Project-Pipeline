blinkit_dbt_project:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "your_snowflake_account"
      user: "your_snowflake_username"
      password: "your_snowflake_password"
      role: "ACCOUNTADMIN"
      warehouse: "BLINKIT_WH"
      database: "BLINKIT_DB"
      schema: "STAGING"
      threads: 4
      client_session_keep_alive: false
